{
  "type": "object",
  "properties": {
    "classifications": {
      "type": "array",
      "description": "Una clasificación por cada publicación recibida",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador original de la publicación"
          },
          "label": {
            "type": "string",
            "enum": [
              "POS",
              "NEG",
              "NEU"
            ],
            "description": "Sentimiento de la publicación"
          },
          "hasIrony": {
            "type": "boolean",
            "description": "Indica si la publicación contiene ironía o sarcasmo"
          }
        },
        "required": [
          "id",
          "label",
          "hasIrony"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "classifications"
  ],
  "additionalProperties": false
}
